# Base de datos PostgreSQL (desarrollo local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cifuentes"

# Base de datos de test con las migraciones aplicadas, para los tests de integración de Prisma.
# Sin esta variable esos tests se saltan (ver docs/testing-strategy.md).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cifuentes_test"

# Catálogo de demostración en memoria (desarrollo y E2E sin PostgreSQL).
# Si no hay DATABASE_URL, la API usa el modo demostración automáticamente.
# En Production tiene que quedarse sin definir (equivale a "false"): con el modo demostración activo
# la web sirve el catálogo de fixture y además se abre el shell del panel (ADR-0023 §5).
# scripts/despliegue-preflight.sh marca PENDIENTE si está activo en Production.
CATALOG_DEMO_MODE="false"

# Días de validez de un presupuesto emitido
QUOTE_VALIDITY_DAYS="30"

# Token compartido del API del panel (publicar tarifas). Sin él esos endpoints responden 503.
# Genera uno propio en local, por ejemplo: openssl rand -hex 32
ADMIN_API_TOKEN=""

# Sesión de la interfaz del panel (CIF-241). Sin las dos, /[locale]/admin queda denegado y la
# página de acceso informa de que no está configurado (falla cerrado, el sitio público sigue vivo).
# Secreto de firma de la cookie: mínimo 32 caracteres, por ejemplo: openssl rand -base64 48
ADMIN_SESSION_SECRET=""
# Credencial del propietario: mínimo 16 caracteres. El MVP tiene un único dueño, sin usuarios ni roles.
ADMIN_PANEL_PASSWORD=""

# Interruptor del shell del panel en Production (ADR-0023 §5). Apagado por defecto: el shell no se
# sirve (404 con una sesión válida; sin sesión, el Proxy manda al acceso, ADR-0024). Ponlo a "true"
# solo para servir el panel, que sigue detrás de la sesión del propietario. En preview y en local el
# panel se sirve sin este interruptor.
# Ojo: CATALOG_DEMO_MODE=true también abre esta guarda; en Production no es una configuración válida.
ADMIN_PANEL_ENABLED="false"

# URL pública de la aplicación
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Entrega del presupuesto en PDF y por email (ADR-0004, CIF-173).
# Sin RESEND_FROM y RESEND_API_KEY la aplicación usa el adaptador de consola: no envía correo real.
# Cuando el propietario confirme el dominio remitente (CIF-14), rellena estos dos valores.
RESEND_FROM=""
RESEND_API_KEY=""

# Destinatarios internos del aviso (buzón del comercial y copias), separados por comas.
QUOTE_INTERNAL_RECIPIENTS=""

# Datos fiscales de la cabecera del PDF. Mientras falten, el PDF los marca como pendientes.
QUOTE_ISSUER_NAME=""
QUOTE_ISSUER_TAX_ID=""
QUOTE_ISSUER_ADDRESS=""
QUOTE_ISSUER_EMAIL=""
QUOTE_ISSUER_PHONE=""
QUOTE_ISSUER_WEBSITE=""

# Condiciones legales del presupuesto, una por línea (\n dentro de las comillas).
QUOTE_CONDITIONS_ES=""
QUOTE_CONDITIONS_EN=""

# Entorno del despliegue: en Vercel lo fija la plataforma (production/preview/development) y no se
# configura a mano. En local se deja sin definir y /api/health informa el valor de NODE_ENV.
# VERCEL_ENV="preview"
